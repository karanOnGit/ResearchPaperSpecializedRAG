# Groq LLM API Key (Get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound
EXTRACTION_MODEL=groq/compound

# MongoDB Connection String (leave blank to use embedded persistent JSON/mock store)
MONGODB_URI=
DATABASE_NAME=research_knowledge_engine

# Vector Index / Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Optional Hugging Face Token (to suppress rate-limit warnings)
HF_TOKEN=

# Server
HOST=0.0.0.0
PORT=8000
