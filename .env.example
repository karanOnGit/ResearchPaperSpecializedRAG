# Groq LLM API Key — normally left blank: enter it in the app under
# Engine Configuration, which stores it in data/.runtime_settings.json (0600).
# Set it here only for headless/container deploys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EXTRACTION_MODEL=llama-3.1-8b-instant

# MongoDB Connection String (leave blank to use embedded persistent JSON/mock store)
MONGODB_URI=
DATABASE_NAME=research_knowledge_engine

# Vector Index / Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Optional Hugging Face Token (to suppress rate-limit warnings)
HF_TOKEN=

# Server
HOST=0.0.0.0
PORT=8000
